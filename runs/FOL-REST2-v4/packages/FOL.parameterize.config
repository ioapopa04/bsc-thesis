# Folate for the v4 runs (md-tools feature/ligand-protonation-and-ligand-amides, b3603e0).
# Same input as the old water run (FOLn-REST2/build/FOL.sdf, neutral COOH); Open Babel's pH model
# protonates it at pH 7.4 (the complexes' protein pH) -> both carboxylates COO-, net -2.
solute:
  kind: ligand
  aliases: [folic_acid, folate]
protonation:
  ligand_method: openbabel
  ph: 7.4
