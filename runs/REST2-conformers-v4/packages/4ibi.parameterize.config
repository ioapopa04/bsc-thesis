# 4ibi (L01) for REST2 v4 (md-tools feature/ligand-protonation-and-ligand-amides, b3603e0).
# Same input molecule as the original runs (packages/4ibi-water/molecule.sdf, neutral); Open Babel's
# pH model protonates it at pH 7.4, as for the folate v4 runs.
solute:
  kind: ligand
  aliases: [4ibi]
protonation:
  ligand_method: openbabel
  ph: 7.4
