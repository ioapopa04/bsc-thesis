# FRa (4LRH chain A) + folate. Folate pose = crystal heavy atoms; H from the package.
# FOL = the EXACT package of the water runs (FOLn-REST2 / FOLn-REST2-50ns): neutral, AM1-BCC,
# openff-2.2.1, LOCAL-OVBPIULPVIDEAO/param_a76881c75970 - copied unchanged to packages/FOL-water.
# atom_map: COOH hydroxyls on the longer crystal C-O bonds (CT-O2 1.346, CD-OE2 1.347 A vs 1.22).
solute:
  kind: complex
ligands:
  - resname: FOL
    parameter: ../../packages/FOL-water
    atom_map: {O1: O1, CT: C1, O2: O2, CA: C2, N: N1, C: C3, O: O3, C11: C4, C12: C5, C13: C6, C14: C7, C15: C8, C16: C9, N10: N2, C9: C10, C6: C11, N5: N3, C4A: C12, C8A: C13, N8: N4, C7: C14, N1: N5, C2: C15, N3: N6, C4: C16, O4: O4, NA2: N7, CB: C17, CG: C18, CD: C19, OE1: O5, OE2: O6}
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
