# Paracetamol v4 (md-tools feature/ligand-protonation-and-ligand-amides b3603e0): same input and
# compound id as REST2-PARA; Open Babel pH model at 7.4 as in FOL-REST2-v4 (a phenol is left neutral).
solute:
  kind: ligand
  compound_id: CHEMBL112
  aliases: [paracetamol, acetaminophen]
protonation:
  ligand_method: openbabel
  ph: 7.4
