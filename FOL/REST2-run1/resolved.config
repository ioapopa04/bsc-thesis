# The configuration these scripts were generated from, fully resolved.
# Every default is written out, so this file alone reproduces the generation.
protocol: REST2
solvent: explicit
dynamics:
  timestep_fs: auto
  temperature_K: 300.0
  pressure_bar: 1.0
  friction_per_ps: 1.0
  barostat_interval_steps: 25
  restraint_kcal_per_mol_A2: 1.0
  tau: 0.0
  phase_space_printout: 0
  seed: 1
stages:
  minimization_iterations: 5000
  restrained_nvt_steps: 50000
  restrained_npt_steps: 50000
  unrestrained_npt_steps: 100000
  production_steps: 2500000
  number_of_segments: 1
reporting:
  crd_printout_solute: 1000
  crd_printout_whole: 50000
  info_printout: 5000
  checkpoint_printout: 50000
collective_variables:
  file: null
  generate: null
  interval_steps: 0
rest2:
  number_of_replicas: 8
  tau_max: 0.4
  backbone_scaling_list: null
  sidechain_scaling_list: null
  ligand_scaling_dict: null
  exchange_interval_steps: 1000
  number_of_exchanges: 25000
  equilibration_steps: 50000
  equilibration_per_tau: false
  state_trajectory: true
  rem_log: true
  neighbour_acceptance_report: true
ais:
  number_of_paths: 100
  switching_steps: 50000
  observation_interval_steps: 2500
  parameter_update_interval_steps: 1
  lambda_schedule: linear
  lambda_schedule_tau0: null
ais_source:
  trajectory: null
  generate: false
  topology: null
  first_frame: 0
  last_frame: null
  frame_stride: 1
  selection: uniform_random
  allow_repeated_frames: false
umbrella:
  file: null
