protonation:
  canonical_smiles: '[H]OC(=O)c1c([H])c([H])c([H])c(N2C(=O)C(O[H])=C(C(=O)c3sc(Cl)c([H])c3[H])[C@]2([H])c2c([H])c(Cl)c3c(c2[H])OC([H])([H])O3)c1[H]'
  digest: a89c2b6b46c003293c9369e837198c2a492e71ad3dd6c340fed5ebb6bd5ddc2c
  fixed_h_inchikey: FYJSIGVCZLLXAT-LTAAYBRJNA-N
