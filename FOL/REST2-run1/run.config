# What is per RUN rather than per method. The shared inputs in input/ say what this
# protocol was asked to do; this says which repeat it is.
#
# Only the seed may be set here -- see `RUN_CONFIG_ALLOWED`. `derive_seed` hashes it with
# each stage and replica name, so every stream in this run descends from this number, and
# two runs sharing an input and a seed would be bit-identical rather than repeats.
dynamics:
  seed: 1
