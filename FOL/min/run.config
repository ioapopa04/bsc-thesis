# The minimisation's own seed. `min/` is SHARED by every run on this system, and this
# is deliberately NOT any run's seed: minimisation draws no velocities and has no seeded
# stochastic element, so no run's sampling descends from it. Every run on this system may
# carry a different `dynamics.seed` in its own run.config without disturbing this one.
dynamics:
  seed: 1
