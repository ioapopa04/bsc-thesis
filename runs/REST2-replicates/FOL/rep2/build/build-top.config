# REST2 replicate rep2 of the v4 water run: build-top.config of /scratch/ipopa/thesis/FOL-REST2-v4/water/build with the package by path.
# Input = start.sdf (pick_starts.py rep2); the package is REUSED, its coordinates are not used.
solute:
  kind: ligand
  residue_name: FOL
  parameters: /scratch/ipopa/thesis/FOL-REST2-v4/packages/FOL
protonation:
  ligand_method: openbabel
  ph: 7.4
