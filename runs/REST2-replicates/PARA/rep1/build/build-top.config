# REST2 replicate rep1 of the v4 water run: build-top.config of /scratch/ipopa/thesis/PARA-REST2-v4/build with the package by path.
# Input = start.sdf (pick_starts.py rep1); the package is REUSED, its coordinates are not used.
solute:
  kind: ligand
  residue_name: TYL
  parameters: /scratch/ipopa/thesis/PARA-REST2-v4/build/parameter
protonation:
  ligand_method: openbabel
  ph: 7.4
